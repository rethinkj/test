<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.rethinkj.test</groupId>
    <artifactId>rethinkj-test-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>rethinkj-test-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>

  <name>rethinkj Test :: Maven Plugin</name>
  <description>Tells the runner what Maven knows about a module: class path, folders and the test JVM's options.</description>

  <properties>
    <maven.version>3.9.11</maven.version>
    <plugin-tools.version>3.15.1</plugin-tools.version>
  </properties>

  <dependencies>
    <!-- Maven provides these to a plugin at run time. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${plugin-tools.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${plugin-tools.version}</version>
        <configuration>
          <goalPrefix>rethinkj-test</goalPrefix>
        </configuration>
        <dependencies>
          <!-- The ASM the plugin brings reads class files up to Java 24. -->
          <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.11.1</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <!-- Runs the goal with Maven on the projects under src/it and checks what it wrote. -->
        <artifactId>maven-invoker-plugin</artifactId>
        <version>3.9.1</version>
        <configuration>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
          <settingsFile>src/it/settings.xml</settingsFile>
          <postBuildHookScript>verify</postBuildHookScript>
          <streamLogsOnFailures>true</streamLogsOnFailures>
          <goals>
            <goal>${project.groupId}:${project.artifactId}:${project.version}:export</goal>
          </goals>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
